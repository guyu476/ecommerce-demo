# ============================================================
# 服务器部署用环境变量
#
# 用法（服务器上，项目根目录）：
#     cp deploy.env.example .env
#     然后修改下面的密码和密钥
#
# 说明：这个 .env 只给 docker compose 读取（用于 ${变量} 替换）。
#       它不会被打进镜像（.dockerignore 已排除），也不会提交到 git。
# ============================================================

# ---- MySQL root 密码 ----
# 只能用「字母 + 数字」，不要出现 @ : / # ? 等符号，
# 否则会破坏 DATABASE_URL 的解析。
MYSQL_ROOT_PASSWORD=ChangeMeToRandomAlphaNum123

# ---- 会话签名密钥 ----
# 必须重新生成，不要用本地开发的那个。
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_HEX

# ---- 待付款订单超时时间（分钟）----
PAY_TIMEOUT_MINUTES=15

# ---- Cookie 安全开关 ----
# false = 允许 http://IP:3000 访问（演示用，当前方案）
# true  = 仅 HTTPS 可用（配置域名和证书后才改）
COOKIE_SECURE=false