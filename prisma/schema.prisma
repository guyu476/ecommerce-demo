// Prisma 数据库模型定义
// 规范：表名、字段名统一 snake_case，通过 @map / @@map 映射；模型名用 PascalCase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 用户 ====================

enum UserRole {
  USER
  MERCHANT
  ADMIN

  @@map("user_role")
}

model User {
  id           Int          @id @default(autoincrement())
  email        String?      @unique @db.VarChar(200)
  phone        String?      @unique @db.VarChar(20)
  passwordHash String       @map("password_hash") @db.VarChar(100)
  nickname     String       @db.VarChar(50)
  role         UserRole     @default(USER)
  avatar       String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  cartItems    CartItem[]
  orders       Order[]
  reviews      Review[]
  addresses    Address[]
  products     Product[]
  shop         Shop?
  favorites    Favorite[]
  favoriteShops FavoriteShop[]
  userCoupons  UserCoupon[]
  issuedCoupons Coupon[]

  @@map("users")
}

// 收货地址簿：下单时可选用，免重复填写
model Address {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName   String   @map("recipient_name") @db.VarChar(50)
  recipientPhone  String   @map("recipient_phone") @db.VarChar(20)
  shippingAddress String   @map("shipping_address") @db.VarChar(500)
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

// ==================== 购物车 ====================

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  // 结算勾选：勾中的才随下单结算（全选/单选都在此字段持久化）
  checked   Boolean  @default(true) @map("checked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@map("cart_items")
}

// ==================== 分类 ====================

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  icon      String?   @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

// ==================== 商品 ====================

enum ProductStatus {
  DRAFT
  ON_SALE
  OFF_SALE

  @@map("product_status")
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(200)
  description String?       @db.Text
  price       Decimal       @db.Decimal(10, 2)
  image       String?       @db.VarChar(500)
  images      String?       @db.MediumText
  stock       Int           @default(0)
  sales       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  // 种子幂等键：seed 数据按此键去重（商品名可被商家修改，不能当幂等键）
  seedKey     String?       @unique @map("seed_key") @db.VarChar(40)
  categoryId  Int?
  category    Category?     @relation(fields: [categoryId], references: [id])
  sellerId    Int?          @map("seller_id")
  seller      User?         @relation(fields: [sellerId], references: [id])
  shopId      Int?          @map("shop_id")
  shop        Shop?         @relation(fields: [shopId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  favorites   Favorite[]

  @@index([categoryId])
  @@index([status])
  @@index([shopId])
  @@map("products")
}

// 收藏夹：商品详情页心形按钮，一用户一商品一条
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([productId])
  @@map("favorites")
}

// 店铺收藏：店铺主页心形按钮，一用户一店一条（与商品收藏分开建表，各自幂等）
model FavoriteShop {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    Int      @map("shop_id")
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, shopId])
  @@index([shopId])
  @@map("favorite_shops")
}

// ==================== 店铺 ====================

enum ShopStatus {
  OPEN
  CLOSED

  @@map("shop_status")
}

// 店铺：商家入驻实体（演示版一人一店），商品通过 shopId 归属店铺
model Shop {
  id          Int        @id @default(autoincrement())
  ownerId     Int        @unique @map("owner_id")
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(500)
  logo        String?    @db.VarChar(16)
  status      ShopStatus @default(OPEN)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  products    Product[]
  favoritedBy FavoriteShop[]

  @@map("shops")
}

// 商品评价：一单一商品一条评价（订单完成后可评）
model Review {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orderId, productId])
  @@index([productId])
  @@map("reviews")
}

// ==================== 订单 ====================

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

// 售后退款：NONE 无申请；REQUESTED 买家已申请；REFUNDED 已退款（模拟打款）；REJECTED 商家驳回
// 驳回后可重新申请（REQUESTED 覆盖 REJECTED）；同意后订单转 CANCELLED 并回补库存
enum RefundStatus {
  NONE
  REQUESTED
  REFUNDED
  REJECTED

  @@map("refund_status")
}

model Order {
  id              Int          @id @default(autoincrement())
  orderNo         String       @unique @map("order_no") @db.VarChar(32)
  // 拆单组：跨店购物一次结算按店铺拆成多笔订单，同组订单共享此 id（幂等重放据此取整组）
  checkoutGroupId String?      @map("checkout_group_id") @db.VarChar(80)
  userId          Int          @map("user_id")
  user            User         @relation(fields: [userId], references: [id])
  status          OrderStatus  @default(PENDING_PAYMENT)
  totalAmount     Decimal      @map("total_amount") @db.Decimal(10, 2)
  discountAmount  Decimal      @default(0) @map("discount_amount") @db.Decimal(10, 2)
  refundStatus    RefundStatus @default(NONE) @map("refund_status")
  refundReason    String?      @map("refund_reason") @db.VarChar(200)
  refundAmount    Decimal?     @map("refund_amount") @db.Decimal(10, 2)
  refundHandledAt DateTime?    @map("refund_handled_at")
  trackingNo      String?      @map("tracking_no") @db.VarChar(64)
  paidAt          DateTime?    @map("paid_at")
  shippedAt       DateTime?    @map("shipped_at")
  completedAt     DateTime?    @map("completed_at")
  recipientName   String       @map("recipient_name") @db.VarChar(50)
  recipientPhone  String       @map("recipient_phone") @db.VarChar(20)
  shippingAddress String       @map("shipping_address") @db.VarChar(500)
  coupon          UserCoupon?
  items           OrderItem[]
  reviews         Review[]
  idempotencyKeys IdempotencyKey[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([checkoutGroupId])
  @@map("orders")
}

// 订单条目：商品名与单价为下单时快照，不受后续改价影响
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  name      String   @map("product_name") @db.VarChar(200)
  price     Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

// 幂等键：下单防重。唯一约束是幂等的实现机制（原子抢占），不是先查后插
model IdempotencyKey {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(80)
  userId      Int      @map("user_id")
  requestHash String   @map("request_hash") @db.VarChar(64)
  orderId     Int?     @map("order_id")
  order       Order?   @relation(fields: [orderId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("idempotency_keys")
}

// ==================== 优惠券 ====================

enum CouponStatus {
  UNUSED
  USED

  @@map("coupon_status")
}

// 券模板：满 threshold 减 discount，限领一张（totalCount 用完即止，条件更新防超发）
// 发券方：ownerId 为空 = 平台券（管理员发，全店通用）；非空 = 店铺券（商家发，限该商家店铺商品满减）
model Coupon {
  id           Int          @id @default(autoincrement())
  title        String       @db.VarChar(100)
  threshold    Decimal      @db.Decimal(10, 2)
  discount     Decimal      @db.Decimal(10, 2)
  totalCount   Int          @map("total_count")
  claimedCount Int          @default(0) @map("claimed_count")
  expiresAt    DateTime     @map("expires_at")
  ownerId      Int?         @map("owner_id")
  owner        User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now()) @map("created_at")
  userCoupons  UserCoupon[]

  @@index([ownerId])
  @@map("coupons")
}

// 用户持有的券：下单抵扣后置 USED；orderId 唯一保证一单至多用一张券
model UserCoupon {
  id        Int          @id @default(autoincrement())
  userId    Int          @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  Int          @map("coupon_id")
  coupon    Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade)
  status    CouponStatus @default(UNUSED)
  usedAt    DateTime?    @map("used_at")
  order     Order?       @relation(fields: [orderId], references: [id])
  orderId   Int?         @unique @map("order_id")
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([userId, couponId])
  @@index([userId])
  @@index([couponId])
  @@map("user_coupons")
}
