// Prisma 数据库模型定义
// 规范：表名、字段名统一 snake_case，通过 @map / @@map 映射；模型名用 PascalCase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 用户 ====================

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(200)
  passwordHash String     @map("password_hash") @db.VarChar(100)
  nickname     String     @db.VarChar(50)
  avatar       String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  cartItems    CartItem[]
  orders       Order[]
  addresses    Address[]

  @@map("users")
}

// 收货地址簿：下单时可选用，免重复填写
model Address {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName   String   @map("recipient_name") @db.VarChar(50)
  recipientPhone  String   @map("recipient_phone") @db.VarChar(20)
  shippingAddress String   @map("shipping_address") @db.VarChar(500)
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

// ==================== 购物车 ====================

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@map("cart_items")
}

// ==================== 分类 ====================

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  icon      String?   @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

// ==================== 商品 ====================

enum ProductStatus {
  DRAFT
  ON_SALE
  OFF_SALE

  @@map("product_status")
}

model Product {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(200)
  description String?       @db.Text
  price       Decimal       @db.Decimal(10, 2)
  image       String?       @db.VarChar(500)
  stock       Int           @default(0)
  sales       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  categoryId  Int?
  category    Category?     @relation(fields: [categoryId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

// ==================== 订单 ====================

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

model Order {
  id              Int         @id @default(autoincrement())
  orderNo         String      @unique @map("order_no") @db.VarChar(32)
  userId          Int         @map("user_id")
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING_PAYMENT)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  recipientName   String      @map("recipient_name") @db.VarChar(50)
  recipientPhone  String      @map("recipient_phone") @db.VarChar(20)
  shippingAddress String      @map("shipping_address") @db.VarChar(500)
  items           OrderItem[]
  idempotencyKeys IdempotencyKey[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@map("orders")
}

// 订单条目：商品名与单价为下单时快照，不受后续改价影响
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  name      String   @map("product_name") @db.VarChar(200)
  price     Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_items")
}

// 幂等键：下单防重。唯一约束是幂等的实现机制（原子抢占），不是先查后插
model IdempotencyKey {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(80)
  userId      Int      @map("user_id")
  requestHash String   @map("request_hash") @db.VarChar(64)
  orderId     Int?     @map("order_id")
  order       Order?   @relation(fields: [orderId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("idempotency_keys")
}
