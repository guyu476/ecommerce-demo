# 复制本文件为 .env 并填入真实值（.env 不提交到 git）

# MySQL 连接串：把 PASSWORD 替换为你的 MySQL root 密码
# 数据库 ecommerce_demo 不存在时，prisma migrate 会自动创建
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/ecommerce_demo"

# 会话签名密钥：随机 64 位 hex，可用如下命令生成
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_RANDOM_HEX"

# 待付款订单支付截止（分钟），超时由定时任务自动取消并释放库存
PAY_TIMEOUT_MINUTES=15

# Cookie 安全开关（可选）
# 生产环境下会话 Cookie 默认带 Secure，只有 HTTPS 才能保存。
# 用 http://IP:3000 访问时必须设为 false，否则浏览器会丢弃 Cookie 导致登录失效。
# 本地开发不需要设置。
# COOKIE_SECURE=false